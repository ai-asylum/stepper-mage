{
  "name": "unbound-descent",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && VITE_GAME_VERSION=${VITE_GAME_VERSION:-$npm_package_version} vite build",

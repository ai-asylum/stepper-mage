    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/three": "^0.169.0",
    "playable-kit": "file:vendor/playable-kit-1.0.0.tgz",
    "playwright-core": "^1.62.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
